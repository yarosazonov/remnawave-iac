global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: "monitor-proxy"
    static_configs:
      - targets: ["host.docker.internal:9100"]

  - job_name: "panel"
    static_configs:
      - targets: ["{{ panel_ip | default('92.118.190.3') }}:9100"]

  - job_name: "nodes"
    static_configs:
      - targets:
{% if groups['remna_nodes'] is defined and groups['remna_nodes'] | length > 0 %}
{% for host in groups['remna_nodes'] %}
        - "{{ hostvars[host]['ansible_host'] | default(host) }}:9100"
{% endfor %}
{% endif %}
