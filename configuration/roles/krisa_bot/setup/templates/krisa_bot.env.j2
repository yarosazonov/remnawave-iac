# Krisa Bot Environment Configuration
# Generated by Ansible - do not edit manually

# Bot Configuration
LOGGING_LVL={{ misc.logging_lvl }}
# Bot specific
BOT_TOKEN={{ lookup('ansible.builtin.env', 'KRISA_BOT_TOKEN') }}
# Unique telegram id, not a username
ADMIN_ID={{ lookup('ansible.builtin.env', 'KRISA_BOT_ADMIN_ID') }}
SUPPORT_TG_LINK={{ misc.support_link }}
CHANNEL_TAG={{ misc.channel_tag }}

# FastAPI
# openssl rand -hex 16
BOT_DOMAIN={{ bot_domain }}
TG_WEBHOOK_PATH='{{ lookup('ansible.builtin.env', 'KRISA_BOT_TG_WEBHOOK_PATH') }}'
TG_WEBHOOK_SECRET='{{ lookup('ansible.builtin.env', 'KRISA_BOT_TG_WEBHOOK_SECRET') }}'
# Don't forget to set it in the yookassa shop
YOOKASSA_WEBHOOK_PATH='{{ lookup('ansible.builtin.env', 'KRISA_BOT_YOOKASSA_WEBHOOK_PATH') }}'
PORT={{ app.port }}

# Remna
# e.g. panel.example.com
REMNAWAVE_PANEL_DOMAIN={{ remna.api_url | urlsplit('hostname') }}
REMNAWAVE_API_TOKEN={{ lookup('ansible.builtin.env', 'KRISA_BOT_REMNAWAVE_API_TOKEN') | default(remnawave_api_token, true) }}
AVAILABLE_SERVERS={{ misc.available_servers | join(',') }}
# Squads to assign to users upon trial or subscription renewal
# Squads should be listed as comma separated values like: SQUADS=UUID0,UUID1,...
SQUADS={{ remna.squads | join(',') }}
# Panel webhook variables, should match the ones in the panel .env
REMNAWAVE_WEBHOOK_PATH={{ lookup('ansible.builtin.env', 'KRISA_BOT_REMNAWAVE_WEBHOOK_PATH') }}
REMNAWAVE_WEBHOOK_SECRET_HEADER={{ lookup('ansible.builtin.env', 'WEBHOOK_SECRET_HEADER') }}

# Trial specs
TRIAL_DAYS={{ trial.days }}
TRIAL_TRAFFIC_GB={{ trial.traffic_gb }}

# Yookassa
YOOKASSA_SHOP_ID={{ lookup('ansible.builtin.env', 'KRISA_BOT_YOOKASSA_SHOP_ID') }}
YOOKASSA_SECRET_KEY={{ lookup('ansible.builtin.env', 'KRISA_BOT_YOOKASSA_SECRET_KEY') }}
YOOKASSA_RETURN_URL={{ yookassa.return_url }}
YOOKASSA_DEFAULT_RECEIPT_EMAIL={{ yookassa.default_receipt_email }}

# Subscription parameters
MONTHLY_TRAFFIC_GB={{ subscription.monthly_traffic_gb }}
ENABLE_1_MONTH={{ subscription.one_month.enabled }}
RUB_PRICE_1_MONTH={{ subscription.one_month.price }}

ENABLE_3_MONTHS={{ subscription.three_months.enabled }}
RUB_PRICE_3_MONTHS={{ subscription.three_months.price }}

ENABLE_6_MONTHS={{ subscription.six_months.enabled }}
RUB_PRICE_6_MONTHS={{ subscription.six_months.price }}

# User permissions - dynamically resolved from target server
USER_NAME={{ admin_username }}
USER_ID={{ admin_uid }}
GROUP_ID={{ admin_gid }}
