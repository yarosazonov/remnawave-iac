# ==========================================
# MANUAL INVENTORY
# You can use this file for ad-hoc playbook runs:
# ansible-playbook -i inventory/manual.ini playbooks/<name>.yml
#
# Copy this file to manual.ini and fill in your actual IPs
# ==========================================

[remna_panel]
remna-panel ansible_host=YOUR_PANEL_IP

[remna_panel:vars]
ansible_user=root
ansible_ssh_private_key_file=~/.ssh/ed25519

# ------------------------------------------

[remna_nodes]
nl-node-0 ansible_host=YOUR_NL_NODE_IP
# etc...

[remna_nodes:vars]
ansible_user=root
ansible_ssh_private_key_file=~/.ssh/ed25519

# ------------------------------------------

[ru-proxy]
ru-proxy ansible_host=YOUR_PROXY_IP

[ru-proxy:vars]
ansible_user=root
ansible_ssh_private_key_file=~/.ssh/ed25519
