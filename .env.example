# Vultr
---
VULTR_API_KEY=""


# Cloudflare
---
CLOUDFLARE_API_TOKEN=""
## Root domain under which panel and nodes sub domains will be created
CLOUDFLARE_ZONE=""
PANEL_SUBDOMAIN="panel"
## Leave empty if you don't wan't to setup a sub page
SUBSCRIPTION_SUBDOMAIN=""
## Don't forget to set KRISA_BOT_BASE_URL to be BOT_SUBDOMAIN + CLOUDFLARE_ZONE 
BOT_SUBDOMAIN=""


# Misc
---
## Creating the admin user and injecting pub key for manual admin login into servers
ADMIN_USERNAME=""
ADMIN_KEY_PATH=""
## Monitoring server IP, node-exporter port will be opened only for this IP
MONITORING_IP=""
## Security feature. Insert only if you run ansible from a server with static IP
ANSIBLE_STATIC_SSH_IP="" 


# Panel related vars
---
## If you want to only deploy nodes you should populate these manually
## But If you're deploying a panel using this setup - it will be populated automatically
PANEL_IP=''
PANEL_DOMAIN=''
PANEL_API_TOKEN=''
## Defaults to "admin" 
PANEL_ADMIN_USERNAME=''
## Pattern:^(?=.*?[A-Z])(?=.*?[a-z])(?=.*?[0-9]).{24,}$
PANEL_ADMIN_PASSWORD=''


# Node related
---
## If you want to only deploy nodes you should populate these manually
## But If you're deploying a panel using this setup - it will be populated automatically
NODE_PORT=2234
CONFIG_PROFILE_UUID=''
ACTIVE_INBOUNDS=''
SECRET_KEY=''


# Backups
---
## Telegram Bot Token (for sending backups)
BOT_TOKEN='YOUR_BOT_TOKEN_HERE'
## Telegram Chat ID to send backups to
ADMIN_ID='YOUR_ADMIN_ID_HERE'
## Days to keep old backups (default: 7)
BACKUP_RETENTION_DAYS=7
## GPG encryption password for backups
BACKUP_PASSWORD='GENERATED_ON_FIRST_RUN'



##############
# Panel .env #
##############

# You can configure your panel .env right here. 
# If you're restoring the panel you should copy paste here your old .env for restore to be successful
# If you don't have an access to your old .env you can run restore with NEW_PANEL_SECRETS=1 which will recrete the admin and delete old API tokens 

### APP ###
APP_PORT=3000
METRICS_PORT=3001

### API ###
# Possible values: max (start instances on all cores), number (start instances on number of cores), -1 (start instances on all cores - 1)
# !!! Do not set this value more than physical cores count in your machine !!!
# Review documentation: https://docs.rw/docs/install/environment-variables#scaling-api
API_INSTANCES=1

### DATABASE ###
# FORMAT: postgresql://{user}:{password}@{host}:{port}/{database}
DATABASE_URL="postgresql://postgres:postgres@remnawave-db:5432/postgres"

### REDIS ###
REDIS_HOST=remnawave-redis
REDIS_PORT=6379

### JWT ###
### CHANGE DEFAULT VALUES ###
JWT_AUTH_SECRET=change_me
JWT_API_TOKENS_SECRET=change_me

### TELEGRAM NOTIFICATIONS ###
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_NOTIFY_USERS_CHAT_ID=change_me
TELEGRAM_NOTIFY_NODES_CHAT_ID=change_me
TELEGRAM_NOTIFY_CRM_CHAT_ID=change_me

# Optional
# Only set if you want to use topics
TELEGRAM_NOTIFY_USERS_THREAD_ID=
TELEGRAM_NOTIFY_NODES_THREAD_ID=
TELEGRAM_NOTIFY_CRM_THREAD_ID=

### FRONT_END ###
# Used by CORS, you can leave it as * or place your domain there
FRONT_END_DOMAIN=*

### SUBSCRIPTION PUBLIC DOMAIN ###
### DOMAIN, WITHOUT HTTP/HTTPS, DO NOT ADD / AT THE END ###
### Used in "profile-web-page-url" response header and in UI/API ###
### Review documentation: https://docs.rw/docs/install/environment-variables#domains
SUB_PUBLIC_DOMAIN=panel.domain.com/api/sub

### If CUSTOM_SUB_PREFIX is set in @remnawave/subscription-page, append the same path to SUB_PUBLIC_DOMAIN. Example: SUB_PUBLIC_DOMAIN=sub-page.example.com/sub

### SWAGGER ###
SWAGGER_PATH=/docs
SCALAR_PATH=/scalar
IS_DOCS_ENABLED=false

### PROMETHEUS ###
### Metrics are available at http://127.0.0.1:METRICS_PORT/metrics
METRICS_USER=admin
METRICS_PASS=admin

# Webhook configuration
# Enable webhook notifications (true/false, defaults to false if not set or empty)
WEBHOOK_ENABLED=false
# Webhook URL to send notifications to (can specify multiple URLs separated by commas if needed)
# Only http:// or https:// are allowed.
WEBHOOK_URL=https://your-webhook-url.com/endpoint
### This secret is used to sign the webhook payload, must be exact 64 characters. Only a-z, 0-9, A-Z are allowed.
WEBHOOK_SECRET_HEADER=vsmu67Kmg6R8FjIOF1WUY8LWBHie4scdEqrfsKmyf4IAf8dY3nFS0wwYHkhh6ZvQ

### Bandwidth usage reached notifications
BANDWIDTH_USAGE_NOTIFICATIONS_ENABLED=false
# Only in ASC order (example: [60, 80]), must be valid array of integer(min: 25, max: 95) numbers. No more than 5 values.
BANDWIDTH_USAGE_NOTIFICATIONS_THRESHOLD=[60, 80]

### Not connected users notification (webhook, telegram)
NOT_CONNECTED_USERS_NOTIFICATIONS_ENABLED=false
# Only in ASC order (example: [6, 12, 24]), must be valid array of integer(min: 1, max: 168) numbers. No more than 3 values.
# Each value represents HOURS passed after user creation (user.createdAt)
NOT_CONNECTED_USERS_NOTIFICATIONS_AFTER_HOURS=[6, 24, 48]

### CLOUDFLARE ###
# USED ONLY FOR docker-compose-prod-with-cf.yml
# NOT USED BY THE APP ITSELF
CLOUDFLARE_TOKEN=ey...

### Database ###
### For Postgres Docker container ###
# NOT USED BY THE APP ITSELF
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres



##################
# Krisa Bot .env #
##################

KRISA_BOT_LOGGING_LVL=INFO

# Bot specific
KRISA_BOT_TOKEN=''
# Unique telegram id, not a username
KRISA_BOT_ADMIN_ID=''
KRISA_BOT_SUPPORT_LINK=''
KRISA_BOT_CHANNEL_TAG=''

# FastAPI
KRISA_BOT_BASE_URL='https://bot.domain.com/'
# generate with openssl rand -hex 16
KRISA_BOT_TG_WEBHOOK_PATH='/webhook/'
KRISA_BOT_TG_WEBHOOK_SECRET=''
# Don't forget to set it in the yookassa shop
KRISA_BOT_YOOKASSA_WEBHOOK_PATH='/webhook/yookassa/'
KRISA_BOT_HOST='0.0.0.0'
KRISA_BOT_PORT=4000

# Remna
# e.g. https://panel.example.com/api
KRISA_BOT_REMNAWAVE_API_URL=''
KRISA_BOT_REMNAWAVE_API_TOKEN=''
KRISA_BOT_AVAILABLE_SERVERS='🇳🇱 Нидерланды,🇺🇸 США,🇯🇵 Япония'
# Squads to assign to users upon trial or subscription renewal
# Squads should be listed as comma separated values like: SQUADS=UUID0,UUID1,...
KRISA_BOT_SQUADS=''
# Panel webhook variables, should match the ones in the panel .env
KRISA_BOT_REMNAWAVE_WEBHOOK_PATH='/webhook/'
KRISA_BOT_REMNAWAVE_WEBHOOK_SECRET_HEADER=''

# Trial specs
KRISA_BOT_TRIAL_DAYS=3
KRISA_BOT_TRIAL_TRAFFIC_GB=25

# Yookassa
YOOKASSA_SHOP_ID=''
YOOKASSA_SECRET_KEY=''
YOOKASSA_RETURN_URL='https://t.me/your_bot'
YOOKASSA_DEFAULT_RECEIPT_EMAIL=''
YOOKASSA_VAT_CODE=1
YOOKASSA_PAYMENT_MODE=full_prepayment
YOOKASSA_PAYMENT_SUBJECT=payment

# Subscription parameters
KRISA_BOT_MONTHLY_TRAFFIC_GB=250
KRISA_BOT_ENABLE_1_MONTH=True
KRISA_BOT_RUB_PRICE_1_MONTH=110

KRISA_BOT_ENABLE_3_MONTHS=True
KRISA_BOT_RUB_PRICE_3_MONTHS=300

KRISA_BOT_ENABLE_6_MONTHS=True
KRISA_BOT_RUB_PRICE_6_MONTHS=650